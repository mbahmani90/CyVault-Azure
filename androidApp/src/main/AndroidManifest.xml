<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CyVaultApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyVault">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="cyvault"
                    android:host="yapily-callback" />
            </intent-filter>
        </activity>

        <!-- MSAL redirect handler. The path is the signing certificate hash (debug keystore),
             not URL-encoded; it must match redirect_uri in auth_config_native_auth.json.
             MissingClass: MSAL is an implementation dependency of :auth, so lint can't see it from here. -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="com.cypressit.cyvault"
                    android:path="/+6PpzKBqQ/0GponbMHq4NRPWiMc=" />
            </intent-filter>
        </activity>
    </application>

</manifest>
